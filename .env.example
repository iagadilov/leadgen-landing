# Telegram-уведомления о заявках с лендинга
# Скопируй в .env (локально) и добавь в Vercel → Project Settings → Environment Variables

# 1) Создай бота: напиши @BotFather в Telegram → /newbot → получишь токен
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# 2) Узнай свой chat_id:
#    - напиши своему боту любое сообщение
#    - открой https://api.telegram.org/bot<ТОКЕН>/getUpdates
#    - возьми число из "chat":{"id": ... }
TELEGRAM_CHAT_ID=123456789
